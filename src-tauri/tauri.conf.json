{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Network Checkup",
  "mainBinaryName": "NetworkCheckup",
  "version": "0.4.0",
  "identifier": "com.kiddodevelopment.networkcheckup",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Network Checkup",
        "width": 1100,
        "height": 820,
        "minWidth": 720,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "app",
      "dmg"
    ],
    "category": "Utility",
    "shortDescription": "Checks your connection, router, internet, DNS and local network",
    "copyright": "kiddodevelopment",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  }
}
